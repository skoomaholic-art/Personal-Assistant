# EXAMPLE ONLY: never commit a filled .env or .dev.vars file.
# Set these as encrypted Cloudflare Secrets for the Worker, not in wrangler.jsonc.
# Never paste real keys, tokens, authorization codes or corporate email into a chat.
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_WEBHOOK_SECRET=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME
GROQ_API_KEY=REPLACE_ME
# Only needed for read-only Gmail API after explicit Google user consent:
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
GMAIL_REFRESH_TOKEN=REPLACE_ME
# Optional old Apps Script bridge, disabled in staging:
INGEST_SECRET=REPLACE_ME

# Personal MTProto mention bridge (add to staging Cloudflare Secrets):
TELEGRAM_MENTION_INGEST_SECRET=REPLACE_ME
# Non-secret Worker vars, explicitly configure before enabling ingestion:
# TELEGRAM_MENTIONS_ENABLED=false
# TELEGRAM_MENTION_CHAT_IDS=
# TELEGRAM_MENTION_PRIVATE_CHAT_IDS=  # comma-separated Telegram User IDs; never *
# TELEGRAM_MENTIONS_AI_ENABLED=false
# TELEGRAM_MENTION_NOTIFICATIONS_ENABLED=false
# Listener process uses TG_API_ID, TG_API_HASH, TG_SESSION_PATH, TG_MENTION_CHAT_IDS,
# TG_MENTION_PRIVATE_CHAT_IDS, TG_MENTION_INGEST_URL and TG_MENTION_INGEST_SECRET. Never share the .session.

# Chat models. Providers are tried in this order; one with no key is skipped.
# 1. Any OpenAI-compatible service (all three values required, HTTPS only):
# AI_BASE_URL=https://example.com/v1   # plain variable
# AI_MODEL=model-id                    # plain variable
AI_API_KEY=REPLACE_ME
# 2. Cerebras (model defaults to gpt-oss-120b; override with CEREBRAS_MODEL):
CEREBRAS_API_KEY=REPLACE_ME
# 3. Groq (GROQ_API_KEY above). Voice transcription always uses Groq.
