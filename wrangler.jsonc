{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rahal-mamut-staging",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-27",
  "vars": {
    "GROQ_MODEL": "openai/gpt-oss-20b",
    "WORK_DOMAIN": "fmedia.kz",
    "TZ_OFFSET_MINUTES": "300",
    "MAIL_INGEST_ENABLED": "false",
    "WORKER_EMAIL_NOTIFICATIONS": "false"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "rahal-mamut-staging",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "rahal-mamut-jobs" }],
    "consumers": [{
      "queue": "rahal-mamut-jobs",
      "max_batch_size": 1,
      "max_batch_timeout": 1,
      "max_retries": 4,
      "dead_letter_queue": "rahal-mamut-dead-letter"
    }]
  }
}